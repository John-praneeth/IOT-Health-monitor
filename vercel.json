{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend/build",
  "installCommand": "npm install --prefix frontend",
  "framework": null,
  "env": {
    "REACT_APP_API_BASE_URL": "https://iot-healthcare-backend.onrender.com",
    "REACT_APP_WS_BASE_URL": "wss://iot-healthcare-backend.onrender.com/ws"
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
